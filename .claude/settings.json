{
  "extraKnownMarketplaces": {
    "repo-padrao": {
      "source": {
        "source": "directory",
        "path": "."
      }
    }
  },
  "enabledPlugins": {
    "context-guard@repo-padrao": true
  },
  "permissions": {
    "allow": [
      "Bash(git commit *)",
      "PowerShell(git commit *)",
      "Bash(git merge *)",
      "PowerShell(git merge *)",
      "Bash(gh issue view*)",
      "Bash(gh issue list*)",
      "Bash(gh issue comment*)",
      "Bash(gh project item-list*)",
      "Bash(gh project view*)",
      "Bash(gh pr view*)",
      "Bash(gh pr list*)",
      "PowerShell(gh issue view*)",
      "PowerShell(gh issue list*)",
      "PowerShell(gh issue comment*)",
      "PowerShell(gh project item-list*)",
      "PowerShell(gh project view*)",
      "PowerShell(gh pr view*)",
      "PowerShell(gh pr list*)"
    ],
    "ask": [
      "Bash(git push *)",
      "PowerShell(git push *)",
      "Bash(gh pr create *)",
      "PowerShell(gh pr create *)",
      "Bash(git rebase *)",
      "PowerShell(git rebase *)",
      "Bash(azd deploy*)",
      "Bash(azd up*)",
      "Bash(az deployment *)",
      "Bash(az webapp deploy*)",
      "PowerShell(azd deploy*)",
      "PowerShell(azd up*)",
      "PowerShell(az deployment *)",
      "PowerShell(az webapp deploy*)",
      "Bash(git commit --amend*)",
      "Bash(git commit * --amend*)",
      "PowerShell(git commit --amend*)",
      "PowerShell(git commit * --amend*)",
      "Bash(git restore *)",
      "PowerShell(git restore *)",
      "Bash(git stash drop*)",
      "Bash(git stash * drop*)",
      "PowerShell(git stash drop*)",
      "PowerShell(git stash * drop*)"
    ],
    "deny": [
      "Bash(git push --force*)",
      "Bash(git push * --force*)",
      "Bash(git push --force-with-lease*)",
      "Bash(git push * --force-with-lease*)",
      "Bash(git push --force-if-includes*)",
      "Bash(git push * --force-if-includes*)",
      "Bash(git push -f*)",
      "Bash(git push * -f*)",
      "Bash(git push --mirror*)",
      "Bash(git push * --mirror*)",
      "PowerShell(git push --force*)",
      "PowerShell(git push * --force*)",
      "PowerShell(git push --force-with-lease*)",
      "PowerShell(git push * --force-with-lease*)",
      "PowerShell(git push --force-if-includes*)",
      "PowerShell(git push * --force-if-includes*)",
      "PowerShell(git push -f*)",
      "PowerShell(git push * -f*)",
      "PowerShell(git push --mirror*)",
      "PowerShell(git push * --mirror*)",
      "Bash(gh pr merge *)",
      "PowerShell(gh pr merge *)",
      "Bash(git branch -d *)",
      "Bash(git branch -D *)",
      "Bash(git branch --delete *)",
      "PowerShell(git branch -d *)",
      "PowerShell(git branch -D *)",
      "PowerShell(git branch --delete *)",
      "Bash(git push --delete*)",
      "Bash(git push * --delete*)",
      "PowerShell(git push --delete*)",
      "PowerShell(git push * --delete*)",
      "Bash(git reset --hard*)",
      "Bash(git reset * --hard*)",
      "PowerShell(git reset --hard*)",
      "PowerShell(git reset * --hard*)",
      "Bash(git clean -f*)",
      "Bash(git clean --force*)",
      "PowerShell(git clean -f*)",
      "PowerShell(git clean --force*)",
      "Bash(git config *)",
      "PowerShell(git config *)"
    ]
  }
}
